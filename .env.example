# API keys — environment only, never in config.json, never committed.
# Only set the ones you use; keyless providers are skipped silently.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
APIFY_TOKEN=

# Host paths for the compose volumes (defaults: ./vault and ./CaptureInbox)
VAULT_DIR=
INBOX_DIR=

# Cloudflare tunnel token — only needed for `docker compose --profile tunnel`
TUNNEL_TOKEN=

# Your domain (e.g. cockpit.example.com) — only for `docker compose --profile proxy`
DOMAIN=

# Google OAuth client (Gmail read + drafts, Calendar read) — see GO-LIVE.md §6.
# The refresh token is stored in data/config.json after you connect; these two
# stay here because they are secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
